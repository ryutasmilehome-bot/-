<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>楽譜ピアノゲーム</title>

<style>
body{
    margin:0;
    background:#111;
    overflow:hidden;
    font-family:sans-serif;
    color:white;
    text-align:center;
}

h1{
    margin:10px;
}

canvas{
    background:#222;
    display:block;
    margin:auto;
    border:3px solid white;
}

#info{
    margin:10px;
    font-size:24px;
}

#keyboard{
    width:600px;
    margin:20px auto;
    display:flex;
}

.key{
    width:120px;
    height:180px;
    background:white;
    border:2px solid black;
    color:black;
    line-height:180px;
    font-size:40px;
    font-weight:bold;
}

.active{
    background:orange !important;
}
</style>
</head>

<body>

<h1>🎹 楽譜ピアノゲーム</h1>

<div id="info">
SCORE: <span id="score">0</span>
</div>

<canvas id="gameCanvas" width="1000" height="400"></canvas>

<div id="keyboard">
    <div class="key" id="key0">A</div>
    <div class="key" id="key1">S</div>
    <div class="key" id="key2">D</div>
    <div class="key" id="key3">F</div>
    <div class="key" id="key4">G</div>
</div>

<script>

const canvas = document.getElementById("gameCanvas");
const ctx = canvas.getContext("2d");

const scoreText = document.getElementById("score");

let score = 0;

const hitX = 180;

const keys = ["a","s","d","f","g"];

const noteNames = ["ド","レ","ミ","ファ","ソ"];

const frequencies = [261,293,329,349,392];

const noteY = [250,230,210,190,170];

const audioCtx = new(window.AudioContext || window.webkitAudioContext)();

function playSound(freq){

    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    osc.frequency.value = freq;
    osc.type = "sine";

    osc.connect(gain);
    gain.connect(audioCtx.destination);

    gain.gain.value = 0.1;

    osc.start();

    gain.gain.exponentialRampToValueAtTime(
        0.0001,
        audioCtx.currentTime + 0.5
    );

    osc.stop(audioCtx.currentTime + 0.5);
}

let notes = [
    {x:1000,note:0},
    {x:1200,note:1},
    {x:1400,note:2},
    {x:1600,note:3},
    {x:1800,note:4},
    {x:2000,note:2},
    {x:2200,note:1},
    {x:2400,note:0},
];

function drawStaff(){

    ctx.strokeStyle = "white";
    ctx.lineWidth = 2;

    for(let i=0; i<5; i++){

        let y = 150 + i * 25;

        ctx.beginPath();
        ctx.moveTo(0,y);
        ctx.lineTo(canvas.width,y);
        ctx.stroke();
    }
}

function drawHitLine(){

    ctx.strokeStyle = "red";
    ctx.lineWidth = 4;

    ctx.beginPath();
    ctx.moveTo(hitX,100);
    ctx.lineTo(hitX,320);
    ctx.stroke();
}

function drawNotes(){

    ctx.fillStyle = "cyan";

    notes.forEach(n=>{

        ctx.beginPath();
        ctx.ellipse(
            n.x,
            noteY[n.note],
            18,
            13,
            0,
            0,
            Math.PI*2
        );

        ctx.fill();

        ctx.fillStyle = "white";

        ctx.font = "18px sans-serif";

        ctx.fillText(
            noteNames[n.note],
            n.x - 10,
            noteY[n.note] - 25
        );

        ctx.fillStyle = "cyan";
    });
}

function updateNotes(){

    notes.forEach(n=>{

        n.x -= 4;
    });

    notes = notes.filter(n=> n.x > -100);
}

function draw(){

    ctx.clearRect(0,0,canvas.width,canvas.height);

    drawStaff();

    drawHitLine();

    drawNotes();
}

function update(){

    updateNotes();
}

function gameLoop(){

    update();

    draw();

    requestAnimationFrame(gameLoop);
}

document.addEventListener("keydown", e=>{

    const key = e.key.toLowerCase();

    const lane = keys.indexOf(key);

    if(lane === -1) return;

    document
        .getElementById("key"+lane)
        .classList.add("active");

    setTimeout(()=>{

        document
            .getElementById("key"+lane)
            .classList.remove("active");

    },120);

    playSound(frequencies[lane]);

    for(let i=0; i<notes.length; i++){

        const n = notes[i];

        if(
            n.note === lane &&
            Math.abs(n.x - hitX) < 40
        ){

            score += 100;

            scoreText.innerText = score;

            notes.splice(i,1);

            return;
        }
    }
});

gameLoop();

</script>

</body>
</html>
