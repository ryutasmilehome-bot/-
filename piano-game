<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>ピアノゲーム</title>

<style>

body{
    margin:0;
    background:#111;
    color:white;
    text-align:center;
    font-family:sans-serif;
}

canvas{
    background:#222;
    border:3px solid white;
    display:block;
    margin:auto;
}

#keyboard{
    display:flex;
    justify-content:center;
    margin-top:20px;
}

.key{
    width:100px;
    height:160px;
    background:white;
    color:black;
    border:2px solid black;
    line-height:160px;
    font-size:40px;
    font-weight:bold;
}

.active{
    background:orange !important;
}

</style>
</head>

<body>

<h1>🎹 楽譜ピアノゲーム</h1>

<h2>SCORE: <span id="score">0</span></h2>

<canvas id="canvas" width="1000" height="400"></canvas>

<div id="keyboard">
<div class="key" id="k0">A</div>
<div class="key" id="k1">S</div>
<div class="key" id="k2">D</div>
<div class="key" id="k3">F</div>
<div class="key" id="k4">G</div>
</div>

<script>

const canvas = document.getElementById("canvas");
const ctx = canvas.getContext("2d");

const keys = ["a","s","d","f","g"];

const freqs = [261,293,329,349,392];

const noteY = [250,230,210,190,170];

let score = 0;

const scoreText = document.getElementById("score");

const audioCtx =
new(window.AudioContext || window.webkitAudioContext)();

function playSound(freq){

    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();

    osc.frequency.value = freq;

    osc.connect(gain);
    gain.connect(audioCtx.destination);

    gain.gain.value = 0.1;

    osc.start();

    gain.gain.exponentialRampToValueAtTime(
        0.0001,
        audioCtx.currentTime + 0.5
    );

    osc.stop(audioCtx.currentTime + 0.5);
}

let notes = [
    {x:1000,n:0},
    {x:1200,n:1},
    {x:1400,n:2},
    {x:1600,n:3},
    {x:1800,n:4},
];

function drawStaff(){

    ctx.strokeStyle = "white";

    for(let i=0;i<5;i++){

        let y = 150 + i*25;

        ctx.beginPath();
        ctx.moveTo(0,y);
        ctx.lineTo(1000,y);
        ctx.stroke();
    }
}

function drawNotes(){

    ctx.fillStyle = "cyan";

    notes.forEach(note=>{

        ctx.beginPath();

        ctx.ellipse(
            note.x,
            noteY[note.n],
            18,
            12,
            0,
            0,
            Math.PI*2
        );

        ctx.fill();
    });
}

function updateNotes(){

    notes.forEach(note=>{

        note.x -= 4;
    });
}

function drawHitLine(){

    ctx.strokeStyle = "red";

    ctx.beginPath();
    ctx.moveTo(180,100);
    ctx.lineTo(180,320);
    ctx.stroke();
}

function loop(){

    ctx.clearRect(0,0,1000,400);

    drawStaff();

    drawHitLine();

    drawNotes();

    updateNotes();

    requestAnimationFrame(loop);
}

document.addEventListener("keydown",e=>{

    const key = e.key.toLowerCase();

    const lane = keys.indexOf(key);

    if(lane === -1) return;

    document
        .getElementById("k"+lane)
        .classList.add("active");

    setTimeout(()=>{

        document
            .getElementById("k"+lane)
            .classList.remove("active");

    },100);

    playSound(freqs[lane]);

    for(let i=0;i<notes.length;i++){

        if(
            notes[i].n === lane &&
            Math.abs(notes[i].x - 180) < 40
        ){

            score += 100;

            scoreText.innerText = score;

            notes.splice(i,1);

            break;
        }
    }
});

loop();

</script>

</body>
</html>
